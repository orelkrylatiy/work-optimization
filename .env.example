# Переменные окружения для Docker контейнера
# Скопируй в .env и заполни свои значения

# Для одного аккаунта HH_PROFILE_ID не нужен.
# Для нескольких аккаунтов используй .profiles и scripts/all-profiles.sh.
# HH_PROFILE_ID=account2
HH_NAME=Максим
HH_TELEGRAM=@maxxwway

# Пути
CONFIG_DIR=/app/config
LOG_DIR=/app/config

# Параметры приложения
APP_ENV=production  # development, staging, production
LOG_LEVEL=INFO

# Admin Panel
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_PORT=8000

# Pyautogui/Playwright опции
HEADLESS=true
BROWSER_TIMEOUT=30000

# Прокси (опционально)
# HTTP_PROXY=
# HTTPS_PROXY=
# SOCKS_PROXY=

# Таймзона
TZ=Europe/Moscow
