#!/bin/sh
# Repository hook: keep normal pre-commit quality checks and stage a fresh ops
# snapshot into ordinary commits. Snapshot failures are non-blocking.
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

# Merge commits add little diagnostic value and can create noisy snapshots.
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0

# core.hooksPath replaces the hook generated by `pre-commit install`, so invoke
# the existing .pre-commit-config.yaml explicitly when the CLI is available.
if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --hook-stage pre-commit || exit $?
elif command -v poetry >/dev/null 2>&1 && poetry run pre-commit --version >/dev/null 2>&1; then
    poetry run pre-commit run --hook-stage pre-commit || exit $?
fi

PY="$(command -v python3 || command -v python)" || PY=""
if [ -z "${PY:-}" ]; then
    echo "pre-commit: python not found; ops snapshot skipped" >&2
    exit 0
fi

REPORT="$("$PY" "$ROOT/scripts/ops/daily_report.py" --date today 2>/dev/null)"
if [ $? -ne 0 ]; then
    echo "pre-commit: daily_report.py failed; committing without fresh ops snapshot" >&2
    exit 0
fi

git -C "$ROOT" add -- ops/latest.json ops/daily >/dev/null 2>&1 || {
    echo "pre-commit: could not stage ops snapshot; continuing" >&2
    exit 0
}

echo "pre-commit: ops snapshot staged (${REPORT:-ops/latest.json})"
exit 0
