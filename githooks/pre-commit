#!/bin/sh
# Repository hook: keep normal pre-commit quality checks and stage fresh ops
# snapshots into ordinary commits. Snapshot failures are non-blocking.
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

# Merge commits add little diagnostic value and can create noisy snapshots.
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0

# core.hooksPath replaces the hook generated by `pre-commit install`, so invoke
# the existing .pre-commit-config.yaml explicitly when the CLI is available.
if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --hook-stage pre-commit || exit $?
elif command -v poetry >/dev/null 2>&1 && poetry run pre-commit --version >/dev/null 2>&1; then
    poetry run pre-commit run --hook-stage pre-commit || exit $?
fi

# The daily publisher has already generated the exact requested date. Rebuilding
# "today" inside its git commit would make ops/latest.json inconsistent with the
# dated file being published. Quality checks above still run for that commit.
if [ "${OPS_SKIP_HOOK_SNAPSHOT:-0}" = "1" ]; then
    exit 0
fi

PY="$(command -v python3 || command -v python)" || PY=""
if [ -z "${PY:-}" ]; then
    echo "pre-commit: python not found; ops snapshots skipped" >&2
    exit 0
fi

if ! REPORT="$("$PY" "$ROOT/scripts/ops/daily_report.py" --date today 2>/dev/null)"; then
    echo "pre-commit: daily_report.py failed; committing without fresh daily snapshot" >&2
    exit 0
fi

if ! EXPERIMENT_REPORT="$("$PY" "$ROOT/scripts/ops/experiment_report.py" 2>/dev/null)"; then
    echo "pre-commit: experiment_report.py failed; committing without fresh experiment snapshot" >&2
    EXPERIMENT_REPORT=""
fi

git -C "$ROOT" add -- ops/latest.json ops/daily >/dev/null 2>&1 || {
    echo "pre-commit: could not stage daily ops snapshot; continuing" >&2
    exit 0
}
if [ -n "$EXPERIMENT_REPORT" ]; then
    git -C "$ROOT" add -- ops/experiments.json >/dev/null 2>&1 || {
        echo "pre-commit: could not stage experiment snapshot; continuing" >&2
    }
fi

echo "pre-commit: ops snapshots staged (${REPORT:-ops/latest.json})"
exit 0
